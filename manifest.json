{
  "id": "rems-watcher",
  "name": "Rems Watcher",
  "version": "1.0.0",
  "author": "RemLover-Dev",
  "repository": "RemLover-Dev/Re-Watch",
  "description": "24/7 background tag monitoring, Pixiv follow tracking, unread counters, and instant notifications.",
  "icon": "bell",
  "entry_point": "plugin.py",
  "min_app_version": "5.3.0",
  "has_ui": true,
  "nav_tab": {
    "id": "Notifications",
    "label": "Notifications",
    "icon_svg": "<svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" style=\"vertical-align:-0.125em;\"><path fill=\"currentColor\" d=\"M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z\"/></svg>",
    "panel_id": "Notifications"
  },
  "panel_html": "<div id=\"Notifications\" class=\"tab-content\" style=\"display: none;\"><div class=\"options-scroll\"><div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;\"><h2 style=\"margin:0;\">🔔 Watchers & Notifications</h2><div style=\"display:flex; gap:8px;\"><button class=\"action-btn\" onclick=\"if(window.remsWatcherCheckNow) remsWatcherCheckNow();\">🔄 Check Now</button><button class=\"action-btn\" onclick=\"if(window.remsWatcherOpenAddDialog) remsWatcherOpenAddDialog();\">➕ New Watcher</button></div></div><div id=\"remsWatcherPanelContent\" style=\"display:flex; flex-direction:column; gap:16px;\"><div class=\"settings-card\" style=\"grid-column: 1 / -1;\"><h3 style=\"margin-top:0;\">Active Watchers</h3><div id=\"remsWatchersList\" style=\"display:flex; flex-direction:column; gap:8px;\"><div style=\"font-size:12px; opacity:0.6;\">Loading watchers...</div></div></div><div class=\"settings-card\" style=\"grid-column: 1 / -1;\"><div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;\"><h3 style=\"margin:0;\">Recent Notifications</h3><button class=\"action-btn\" onclick=\"if(window.remsWatcherClearAll) remsWatcherClearAll();\" style=\"font-size:11px; padding:3px 8px;\">Clear All</button></div><div id=\"remsNotificationsFeed\" style=\"display:flex; flex-direction:column; gap:10px; max-height:450px; overflow-y:auto;\"><div style=\"font-size:12px; opacity:0.6;\">No notifications yet.</div></div></div></div></div></div>"
}
